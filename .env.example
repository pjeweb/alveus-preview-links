# Optional. Without these, static import tracing and overlay rules are used.
OPENAI_API_KEY=
OPENAI_MODEL=
# A compatible provider must support Responses API structured output.
# OPENAI_BASE_URL=https://api.openai.com/v1/

# Optional for local runs: gh auth login is sufficient for dry runs.
# GH_TOKEN=
# Empty means every author's PRs, as in config.json.
# PR_AUTHOR=

# For a GitHub App installation token in GH_TOKEN (derived from the app slug):
# PREVIEW_BOT_LOGIN=alveus-preview-links[bot]
# Optional one-time migration: remove this account's old marked comments only
# after the app has successfully posted its replacement.
# PREVIEW_LEGACY_LOGIN=pjeweb
